GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=3000

# Firestore server access. On first startup, existing data/site-data.json records
# are imported into Firestore if appMetadata/storeInitialized does not exist.
FIREBASE_PROJECT_ID=your-firebase-project-id
# For local development, point this to the downloaded key file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Set this to the service account JSON as a host secret on non-Google hosting.
# On Google Cloud, use the service identity and leave this empty.
FIREBASE_SERVICE_ACCOUNT=

# Configure a Resend API key and a verified sender address to deliver password reset links.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Use Razorpay test credentials for development; set approved deposits per trip slug.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BOOKING_DEPOSITS_INR={}

# Configure these as server-side environment variables in production. Register the exact
# HTTPS callback URLs below in each provider's OAuth console; localhost URLs only work locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=secrets/AuthKey.p8
APPLE_REDIRECT_URI=http://localhost:3000/auth/apple/callback

# In production, also set NODE_ENV=production and APP_BASE_URL to the public HTTPS site URL.
# The app must run with `npm start` on the host-provided PORT (the server binds 0.0.0.0).
